parameters:
    level: 6
    paths:
        - src
        - tests
    ignoreErrors:
        -
          identifier: missingType.generics
        # ServiceListener::addServiceManager() is documented as taking a string,
        # but explicitly handles a ServiceManager instance too - which is what
        # laminas-mvc itself passed for the "service_manager" key.
        -
          identifier: argument.type
          path: tests/ServiceManagerFactory.php
        - '#defaultDocumentRepositoryClassName with type .* is not subtype of native type string#'
        - '#Method .*Configuration::getDefaultDocumentRepositoryClassName\(\) never returns null#'
includes:
    - vendor/jangregor/phpstan-prophecy/extension.neon
